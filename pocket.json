{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.figma",
  "name": "pocket-figma",
  "title": "Pocket Figma",
  "version": "0.1.2",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ],
      "enhances": [
        "input.analog.left",
        "input.touch",
        "display.viewport.live"
      ]
    }
  },
  "app": {
    "entry": "app/main.tsx",
    "output": "pocket-figma",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [480, 272],
        "presentation": "integer-fit"
      },
      "dynamic": {
        "default": [640, 360],
        "min": [360, 360],
        "max": [640, 640]
      }
    }
  }
}
